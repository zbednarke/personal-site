[Unit]
Description=Private-path sign-in (Google) for zachbednarke.com
After=network.target

[Service]
User=caddy
Group=caddy
ExecStart=/usr/local/bin/jazz-auth
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict

[Install]
WantedBy=multi-user.target
