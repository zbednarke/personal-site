# Add these directives inside the existing zachbednarke.com site block,
# before its file_server directive. Do not commit a plaintext password.
#
# To use the same login as portal.zachbednarke.com, replace the environment
# placeholders with the existing username and password hash from that site's
# basic_auth block. Caddy accepts password hashes only, never plaintext.

@jazz_private {
    path /jazz /jazz/* /assets/jazz/*
}

basic_auth @jazz_private bcrypt restricted {
    {$JAZZ_AUTH_USER} {$JAZZ_AUTH_HASH}
}

header @jazz_private {
    X-Robots-Tag "noindex, nofollow, noarchive"
    Cache-Control "private, no-store"
    Referrer-Policy "no-referrer"
}
